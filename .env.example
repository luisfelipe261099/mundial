# Variáveis de ambiente — Auto Mecânica Mundial
# Copie para .env e preencha. Em produção, configure TODAS na Vercel
# (Settings → Environment Variables, escopo Production).

# Postgres (Retool DB / Neon). Use o endpoint POOLED (host com "-pooler") —
# obrigatório em serverless para não esgotar conexões.
DATABASE_URL=

# Assinatura HMAC dos cookies de sessão. Gere com:
#   openssl rand -base64 48
# Em produção o app se recusa a subir sessão sem esta variável.
SESSION_SECRET=

# Protege GET /api/cron/reminders (a Vercel envia "Authorization: Bearer <valor>").
# Sem ela a rota responde 401 para tudo, inclusive para o cron da Vercel.
CRON_SECRET=

# Web Push (VAPID). Gere o par com: npx web-push generate-vapid-keys
# A pública é inlined no client no build — precisa existir na Vercel no build.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Upload de fotos (Vercel Blob). Na Vercel é injetada automaticamente ao
# conectar um Blob store ao projeto; localmente puxe com `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
